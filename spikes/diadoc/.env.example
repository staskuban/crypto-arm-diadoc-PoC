# Copy to .env (git-ignored) and fill in. Never commit real values.

# Integrator cabinet → application → client_id
DIADOC_CLIENT_ID=
# Integrator cabinet → «API-ключи» → «+ Выпустить ключ» (this is client_secret)
DIADOC_CLIENT_SECRET=
# Integrator cabinet → «Выпуск токенов» (clientMode=AuthorizationCode, scopes incl. Diadoc.PublicAPI.Staging)
DIADOC_REFRESH_TOKEN=
# Preferred: the refresh-token file shared with the main CLI (wins over DIADOC_REFRESH_TOKEN; a rotated
# token is written back to it, .state keeps only a hash). Never keep a second diverging copy.
# DIADOC_REFRESH_TOKEN_FILE=../../.diadoc-refresh-token

# Box ids. The quickstart test boxes (diadoc.kontur.ru/easyregistration) are IsTest organisations on the
# PRODUCTION host (D191): use DIADOC_API_URL=https://diadoc-api.kontur.ru for them. Prefer the BoxId form <32 hex>@diadoc.ru (as in Diadoc samples);
# a GUID also works for queries. Staging ids differ from prod ids.
# Sender = seller; recipient = buyer. Both test boxes must be counteragents of each other.
DIADOC_FROM_BOX_ID=
DIADOC_TO_BOX_ID=

# Defaults, change only if Kontur says otherwise
# staging: https://diadoc-api-staging.kontur.ru (does not know the quickstart test boxes)
DIADOC_API_URL=https://diadoc-api.kontur.ru
DIADOC_TOKEN_URL=https://identity.kontur.ru/connect/token

# Signer written into <Подписант> before signing: LAST/FIRST are required for online documents.
# Use the service account's name (test signature) or the certificate owner's name (real CMS).
UTD_SIGNER_LAST_NAME=
UTD_SIGNER_FIRST_NAME=
UTD_SIGNER_MIDDLE_NAME=
UTD_SIGNER_POSITION=
# СпосПодтПолном: 1 = by the signature certificate data (default), 6 = other
UTD_SIGNER_POWERS=1
