# Copy to .env and fill in. Never commit .env.

# КриптоАРМ Server (see docker/cryptoarm-server, task I1)
CRYPTOARM_SERVER_URL=http://localhost:3037
CRYPTOARM_SERVER_API_KEY=change-me-api-key
# Path to the public .cer of the signing certificate (the private key stays in the server store)
SIGNER_CERT_PATH=./docker/cryptoarm-server/certs/cryptoarm.server.test.cer
# Optional per-request timeout in ms (default 120000)
# CRYPTOARM_SERVER_TIMEOUT_MS=120000

# Signer: server (default, КриптоАРМ Server /cms/sign) or documents (КриптоАРМ Документы cloud-sign,
# see docker/cryptoarm-documents). With documents, SIGNER_CERT_PATH is the .cer the CA service maps
# to the Документы user's e-mail (the pipeline rejects a signature by any other certificate), and
# CRYPTOARM_SERVER_URL (+ API key) above is still required: signatures are verified on its /cms/verify.
# Host CLI only (npm run cli): the Docker app service does not support documents yet — inside the
# container 127.0.0.1:3040 is the container itself and the *_FILE paths below are not mounted.
# SIGNER_KIND=server
# DOCUMENTS_URL=http://127.0.0.1:3040
# Auth (X-API-KEY does not work, D9): either a Bearer JWT of the service user (GET /api/v1/auth/jwt,
# not renewed; file preferred) ...
# DOCUMENTS_JWT_FILE=./.documents-jwt
# DOCUMENTS_JWT=changeme
# ... or local login, exchanged for a 15 min JWT renewed automatically (file preferred)
# DOCUMENTS_LOGIN=changeme
# DOCUMENTS_PASSWORD_FILE=./docker/cryptoarm-documents/secrets/admin_password
# DOCUMENTS_PASSWORD=changeme
# MIME type of the upload part, must match the stand's ALLOWED_FILE_TYPES (default application/octet-stream)
# DOCUMENTS_UPLOAD_CONTENT_TYPE=application/octet-stream
# DOCUMENTS_TIMEOUT_MS=120000

# Контур.Диадок (OIDC refresh token flow). No default host: set staging or prod explicitly.
# Staging https://diadoc-api-staging.kontur.ru, prod https://diadoc-api.kontur.ru; box ids differ between them.
DIADOC_API_URL=https://diadoc-api-staging.kontur.ru
# Informational: the scope is fixed when the refresh token is issued in the integrator cabinet.
DIADOC_OIDC_SCOPE=Diadoc.PublicAPI.Staging
DIADOC_CLIENT_ID=changeme
DIADOC_CLIENT_SECRET=changeme
# Either the token itself, or (preferred) a file with it: the CLI writes a rotated token back there.
DIADOC_REFRESH_TOKEN=changeme
# Prefer a path outside the repo (only .diadoc-refresh-token* is git-ignored). Must be a regular file,
# not a symlink; its directory must be writable. The CLI holds <file>.lock during a run (delete it by
# hand after a kill -9) and writes via <file>.tmp.
# DIADOC_REFRESH_TOKEN_FILE=./.diadoc-refresh-token
# DIADOC_TOKEN_URL=https://identity.kontur.ru/connect/token
# DIADOC_TIMEOUT_MS=60000
DIADOC_FROM_BOX_ID=changeme
DIADOC_TO_BOX_ID=changeme

# Pipeline (src/pipeline, CLI `npm run cli -- send <file.xml>`)
# PIPELINE_PRECHECK=true
# Status polling: exponential backoff from INITIAL to MAX delay, stops after TIMEOUT (0 = read once)
# PIPELINE_STATUS_TIMEOUT_MS=60000
# PIPELINE_STATUS_INITIAL_DELAY_MS=2000
# PIPELINE_STATUS_MAX_DELAY_MS=30000

# Docker app service (`docker compose run --rm app send <ИдФайл>.xml`, see docker-compose.yml).
# Compose reads this file both as the app's env_file (all of it, secrets included, lands in the
# container env) and for interpolation. Inside the container CRYPTOARM_SERVER_URL, SIGNER_CERT_PATH
# and DIADOC_REFRESH_TOKEN_FILE are overridden: the server is reached as http://cryptoarm-server:3037,
# the host file SIGNER_CERT_PATH above is mounted read-only (if SIGNER_CERT_PATH is unset:
# docker/cryptoarm-server/certs/cryptoarm.server.test.cer; it must exist), and the refresh token lives
# on the external volume kryptoarm-diadoc-diadoc-token. The container runs as uid 1000: on Linux the
# .cer and the УПД files must be readable by it. Seed the token once (UTD_DIR and the .cer must exist;
# the CLI then writes rotated tokens back to the volume, so delete token.txt afterwards):
#   docker volume create kryptoarm-diadoc-diadoc-token
#   docker compose run --rm -T --no-deps --entrypoint sh app -c 'umask 077; cat > "$DIADOC_REFRESH_TOKEN_FILE"' < token.txt
# A run holds "$DIADOC_REFRESH_TOKEN_FILE.lock" on the volume. PostMessage is not interrupted and may
# retry for minutes, so stop a container with a long grace period (docker stop -t 600); after a hard
# kill, check that no send is running and remove the stale lock:
#   docker compose run --rm --no-deps --entrypoint sh app -c 'cat "$DIADOC_REFRESH_TOKEN_FILE.lock"; rm "$DIADOC_REFRESH_TOKEN_FILE.lock"'
# Host directory with the УПД files, mounted read-only as the working directory (must exist)
# UTD_DIR=./utd
