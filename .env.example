# Copy to .env and fill in. Never commit .env.

# КриптоАРМ Server (see docker/cryptoarm-server, task I1)
CRYPTOARM_SERVER_URL=http://localhost:3037
CRYPTOARM_SERVER_API_KEY=changeme
# Path to the public .cer of the signing certificate (the private key stays in the server store)
SIGNER_CERT_PATH=./certs/signer.cer
# Optional per-request timeout in ms (default 120000)
# CRYPTOARM_SERVER_TIMEOUT_MS=120000

# Контур.Диадок (OIDC refresh token flow). No default host: set staging or prod explicitly.
# Staging https://diadoc-api-staging.kontur.ru, prod https://diadoc-api.kontur.ru; box ids differ between them.
DIADOC_API_URL=https://diadoc-api-staging.kontur.ru
# Informational: the scope is fixed when the refresh token is issued in the integrator cabinet.
DIADOC_OIDC_SCOPE=Diadoc.PublicAPI.Staging
DIADOC_CLIENT_ID=changeme
DIADOC_CLIENT_SECRET=changeme
# Either the token itself, or (preferred) a file with it: the CLI writes a rotated token back there.
DIADOC_REFRESH_TOKEN=changeme
# DIADOC_REFRESH_TOKEN_FILE=./.diadoc-refresh-token
# DIADOC_TOKEN_URL=https://identity.kontur.ru/connect/token
# DIADOC_TIMEOUT_MS=60000
DIADOC_FROM_BOX_ID=changeme
DIADOC_TO_BOX_ID=changeme

# Pipeline (src/pipeline, CLI `npm run cli -- send <file.xml>`)
# PIPELINE_PRECHECK=true
# Status polling: exponential backoff from INITIAL to MAX delay, stops after TIMEOUT (0 = read once)
# PIPELINE_STATUS_TIMEOUT_MS=60000
# PIPELINE_STATUS_INITIAL_DELAY_MS=2000
# PIPELINE_STATUS_MAX_DELAY_MS=30000
