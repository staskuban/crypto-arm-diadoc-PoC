# Optional: copy to .env (git-ignored) next to docker-compose.yml to override the defaults below.
# NO SECRETS here: they live in ./secrets (git-ignored), filled by scripts/documents-secrets.sh and
# read by start.sh (license_value, sign_service_api_key, admin_password, session_secret, secret,
# mail_link_token_secret, api_key, postgres_password).

# Host port of the API (loopback only).
DOCUMENTS_API_PORT=3040

# The running КриптоАРМ Server stand: its compose network (<project>_default) and its URL inside it.
# Nothing here starts or recreates that stand.
SIGN_SERVICE_NETWORK=graph-root_default
SIGN_SERVICE_URL=http://kryptoarm-diadoc-cryptoarm-server:3037

# Directory with the public .cer files named in ca-stub/nginx.conf (e-mail -> certificate). They must
# be the certificates whose keys are installed in the running server's uMy store.
SIGNER_CERTS_DIR=../cryptoarm-server/certs

# First local admin (created once, on an empty DB). Its e-mail is its cloud-sign identity.
DOCUMENTS_ADMIN_LOGIN=admin
DOCUMENTS_ADMIN_EMAIL=server-test@documents.local

# Upload MIME subtypes (regex alternatives matched against the end of the part's Content-Type).
DOCUMENTS_ALLOWED_FILE_TYPES=pdf|txt|plain|xml|octet-stream

# Container limits (I6, README.md "Container hardening"); defaults below.
# DOCUMENTS_API_CPUS=1
# DOCUMENTS_API_MEMORY=1g
# DOCUMENTS_API_PIDS=256
# DOCUMENTS_DB_CPUS=1
# DOCUMENTS_DB_MEMORY=512m
# DOCUMENTS_DB_PIDS=128
# DOCUMENTS_CA_STUB_CPUS=0.25
# DOCUMENTS_CA_STUB_MEMORY=64m
# DOCUMENTS_CA_STUB_PIDS=32

# Image overrides (all three images are pinned by tag + digest by default). The db runs as uid 999 and
# the ca-stub as uid 101 (F17, README.md "Container hardening"): another image needs matching users.
# DOCUMENTS_API_IMAGE=registry.digtlab.ru/trusted/cryptoarm/documents/api:1.0.209@sha256:a0854a75c60b576cbd8989a992e96edf1d1d29003f7dea0eb3256630c69096d4
# DOCUMENTS_DB_IMAGE=postgres:14.4@sha256:9ceb24f8c5f15c053d973a3610866f473690875dc13eb3282b45302189321040   # Debian-based: compose sets uid/gid 999 on the /run/postgresql tmpfs
# DOCUMENTS_CA_STUB_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
