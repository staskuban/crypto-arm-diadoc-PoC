# Copy to .env (git-ignored) and fill in. Never commit .env.
# Full list of server options: upstream .env.example in
# https://git.digtlab.ru/trusted/cryptoarm/server

# Licenses:
#   CRYPTOPRO_LICENSE empty -> КриптоПро CSP trial (Demo, 90 days);
#   TRUSTED_LICENSE REQUIRED -> КриптоАРМ Server key (7x5 chars) from the vendor; without a valid key
#                              the server exits "Trusted Crypto license is invalid" (restart loop).
TRUSTED_LICENSE=
CRYPTOPRO_LICENSE=
CRYPTOPRO_TSP_LICENSE=
CRYPTOPRO_OCSP_LICENSE=

# Server
# Container port; docker-compose.yml and the healthcheck assume 3037, change CRYPTOARM_SERVER_PORT instead.
PORT=3037
SWAGGER_BASE_PATH=/docs
JSON_LIMIT=50mb
LOG_LEVEL=debug,log,warn,error
# Host port published by docker compose
CRYPTOARM_SERVER_PORT=3037

# Auth: "none" or "apikey". With apikey, clients send X-API-Key / Bearer / ?apiKey=.
AUTH_MODE=apikey
API_KEYS=change-me-api-key

# Keys installed into the container store at start (alternative to certs/user/*.pfx).
# Comma-separated Base64 PKCS#12 containers; PINs comma-separated by index, or one PIN for all.
CERT_PFX_BASE64=
CERT_PFX_PIN=
# Comma-separated Base64 root certificates for the mroot store (alternative to certs/root/*.cer).
ROOT_CERTS_BASE64=
