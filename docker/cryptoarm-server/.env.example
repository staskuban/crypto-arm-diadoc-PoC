# Copy to .env (git-ignored, `chmod 600 .env`) and fill in. Never commit .env.
# Full list of server options: upstream .env.example in
# https://git.digtlab.ru/trusted/cryptoarm/server
#
# Secrets belong in files under ./secrets (mounted read-only at /run/secrets), not here: values in
# this file end up in the container config (`docker inspect`) and /proc/*/environ. start.sh reads
#   secrets/trusted_license         КриптоАРМ Server key (7x5 chars) from the vendor — REQUIRED:
#                                   without a valid key the server exits "Trusted Crypto license is
#                                   invalid" (restart loop)
#   secrets/cryptopro_license       КриптоПро CSP serial; missing/empty -> CSP trial (Demo, 90 days)
#   secrets/cryptopro_tsp_license   optional
#   secrets/cryptopro_ocsp_license  optional
#   secrets/api_keys                API keys, one per line (or comma-separated)
#   secrets/<name>.pfx|.p12         key containers for uMy; PIN (if any) in secrets/<name>.pfx.pin
# e.g. (umask 077; printf '%s' "$KEY" > secrets/trusted_license).
#
# Legacy: the variables below still work when the file is absent (a file wins over a non-empty
# value, with a warning). Leave them empty on a stand with real keys.
TRUSTED_LICENSE=
CRYPTOPRO_LICENSE=
CRYPTOPRO_TSP_LICENSE=
CRYPTOPRO_OCSP_LICENSE=
API_KEYS=
# TEST KEYS ONLY: comma-separated Base64 PKCS#12 containers; PINs comma-separated by index, or one
# PIN for all. Real keys: secrets/*.pfx (+ .pin) or certs/user/*.pfx (no PIN).
CERT_PFX_BASE64=
CERT_PFX_PIN=
# Comma-separated Base64 root certificates for the mroot store (alternative to certs/root/*.cer).
ROOT_CERTS_BASE64=

# Server
# Container port; docker-compose.yml and the healthcheck assume 3037, change CRYPTOARM_SERVER_PORT instead.
PORT=3037
SWAGGER_BASE_PATH=/docs
JSON_LIMIT=50mb
# No debug/log: at `log` the server prints the first 8 characters of the API key on every request.
LOG_LEVEL=warn,error
# Host port published by docker compose
CRYPTOARM_SERVER_PORT=3037

# Auth: "none" or "apikey". With apikey, clients send X-API-Key / Bearer / ?apiKey=.
AUTH_MODE=apikey
